# Copy to .env.local (local) or add in your host's environment settings.

# Dashboard password. Defaults to 123456 when unset.
# Once a password is set in Dashboard → Settings → Password, that one is used instead.
ADMIN_PASSWORD=

# Optional: always lets you sign in, for when the dashboard password is forgotten.
# Set it, sign in, change the password in Settings, then remove it again.
ADMIN_RECOVERY_PASSWORD=

# Neon Postgres connection string (Neon dashboard → Connect). Server-only secret.
# Leave empty to store data in ./data instead. Tables are created automatically.
DATABASE_URL=
