# Copy to .env.local (local) or add in your host's environment settings.

# Dashboard password. Defaults to 123456 when unset.
ADMIN_PASSWORD=

# Supabase (Project Settings → API). Leave empty to store data in ./data instead.
SUPABASE_URL=
# Server-only secret. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket name (created by supabase/schema.sql)
SUPABASE_BUCKET=uploads
